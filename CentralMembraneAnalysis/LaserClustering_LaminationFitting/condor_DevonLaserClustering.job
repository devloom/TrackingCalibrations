Universe	= vanilla
Executable	= DevonLaserClustering.sh
notification	= Never
Output		= /sphenix/user/dloomis/logs/lasers_run$(runnumber)_$(clusterId).$(process).txt
Error		= /sphenix/user/dloomis/logs/lasers_run$(runnumber)_$(clusterId).$(process).err
Log		= /tmp/condor_dloomis_$(clusterId).$(process).log
Initialdir	= /sphenix/user/dloomis/CentralMembraneAnalysis/LaserClustering_LaminationFitting
Arguments	= $(runnumber) $(segment) ana556_2025p013_v001 run3calib Jul29_LaserClustersFull_83319_idealtpccoordinates
request_memory	= 4000MB
PeriodicHold = (NumJobStarts>=1 && JobStatus == 1)
Queue runnumber, segment from queue_83319_segs.list
